@page "/"
@using GTAGarageManager.Models
@using GTAGarageManager.Services
@inject GarageService GarageService
@inject IJSRuntime JSRuntime
@inject IWebHostEnvironment Env

<PageTitle>GTA Garage Manager</PageTitle>

<div class="topbar">
    <div class="topbar-titel">
        <span class="titel-gta">GTA ONLINE</span>
        <span class="titel-rest">GARAGE MANAGER</span>
    </div>
    <div class="topbar-stats">
        Fahrzeuge gesamt: <strong>@GarageService.GesamtFahrzeuge</strong>
        &nbsp;|&nbsp;
        Duplikate: <strong>@GarageService.DuplikatTypen Typen (@GarageService.DuplikatGesamt x)</strong>
    </div>
</div>

<div style="padding: 12px 16px 0 16px;">
    <button class="btn-neu-garage" @onclick="NeueGarageOeffnen">+ Neue Garage</button>
</div>

<div class="garagen-grid" id="garagen-sortable">
    @for (int gi = 0; gi < GarageService.Garagen.Count; gi++)
    {
        var garage = GarageService.Garagen[gi];
        var garageIndex = gi;

        <div class="garage-karte" @key="garage.Name">
            <div class="garage-header">
                <span class="drag-handle">☰</span>
                <span class="garage-name">@garage.Name</span>
                <div style="display:flex; gap:4px; align-items:center;">
                    <span class="garage-kapazitaet">@garage.Kapazitaet</span>
                    <button class="btn-bearbeiten" @onclick="() => BearbeitenOeffnen(garage)">✏</button>
                </div>
            </div>

            <div class="fahrzeug-liste" id="fahrzeug-sortable-@garageIndex">
                @foreach (var fahrzeug in garage.Fahrzeuge)
                {
                    <div class="fahrzeug-zeile @(fahrzeug.IsDuplikat ? "duplikat" : "") @(fahrzeug.IsLeer ? "leer" : "")" @key="fahrzeug.SlotNummer">
                        <span class="fahrzeug-drag-handle">⠿</span>
                        <span class="slot-nummer">@fahrzeug.SlotNummer</span>
                        <span class="fahrzeug-name">@fahrzeug.AnzeigeName</span>
                        @if (fahrzeug.IsDuplikat)
                        {
                            <span class="duplikat-icon">!</span>
                        }
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(garage.FotoPath))
            {
                <img src="fotos/@garage.FotoPath" class="garage-foto" />
            }
            else
            {
                <div class="garage-foto-leer">kein Foto</div>
            }
        </div>
    }
</div>

@if (bearbeitenGarage != null)
{
    <div class="modal-overlay" @onclick="BearbeitenSchliessen">
        <div class="modal-inhalt" @onclick:stopPropagation>
            <div class="modal-header">
                <input class="modal-garage-name" @bind="editGarageName" placeholder="Garage-Name" />
                <button class="btn-schliessen" @onclick="BearbeitenSchliessen">✕</button>
            </div>
            <div class="modal-fahrzeuge">
                @foreach (var fahrzeug in bearbeitenGarage.Fahrzeuge.ToList())
                {
                    <div class="modal-zeile">
                        <span class="modal-slot">@fahrzeug.SlotNummer</span>
                        <input class="modal-input" @bind="fahrzeug.Name" placeholder="Fahrzeugname" />
                        <button class="btn-loeschen" @onclick="() => FahrzeugLoeschenClick(fahrzeug)">×</button>
                    </div>
                }
            </div>
            <div class="modal-neu">
                <input class="modal-input" @bind="neuesFahrzeug" placeholder="Neues Fahrzeug..."
                       @onkeydown="@(e => { if (e.Key == "Enter") FahrzeugHinzufuegenClick(); })" />
                <button class="btn-hinzufuegen" @onclick="FahrzeugHinzufuegenClick">+ Hinzufügen</button>
            </div>
            <div class="modal-foto">
                @if (!string.IsNullOrEmpty(bearbeitenGarage.FotoPath))
                {
                    <img src="fotos/@bearbeitenGarage.FotoPath" class="modal-foto-vorschau" />
                    <button class="btn-foto-loeschen" @onclick="FotoLoeschenClick">Foto entfernen</button>
                }
                <InputFile OnChange="FotoHochladen" accept="image/*" class="foto-input" />
                <label>Foto hochladen</label>
            </div>
            <div class="modal-footer">
                <button class="btn-speichern" @onclick="BearbeitenSpeichern">Speichern</button>
                <button class="btn-garage-loeschen" @onclick="GarageLoeschenClick">Garage löschen</button>
            </div>
        </div>
    </div>
}

@if (neueGarageOffen)
{
    <div class="modal-overlay" @onclick="NeueGarageSchliessen">
        <div class="modal-inhalt" @onclick:stopPropagation>
            <div class="modal-header">
                <span style="color:#ff9500; font-weight:bold; font-size:16px;">Neue Garage anlegen</span>
                <button class="btn-schliessen" @onclick="NeueGarageSchliessen">✕</button>
            </div>
            <div style="padding: 16px;">
                <input class="modal-input" style="width:100%;" @bind="neuerGarageName"
                       placeholder="Name der Garage..."
                       @onkeydown="@(e => { if (e.Key == "Enter") NeueGarageSpeichern(); })" />
            </div>
            <div class="modal-footer">
                <button class="btn-speichern" @onclick="NeueGarageSpeichern">Anlegen</button>
            </div>
        </div>
    </div>
}

@code {
    private Garage? bearbeitenGarage = null;
    private string editGarageName = "";
    private string neuesFahrzeug = "";
    private string neuerGarageName = "";
    private bool neueGarageOffen = false;
    private DotNetObjectReference<Garagen>? dotnetRef;

    protected override async Task OnInitializedAsync()
    {
        await GarageService.LadeAlleGaragen();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)  // ← NUR beim ersten Render!
        {
            dotnetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("initSortable", dotnetRef);
            for (int i = 0; i < GarageService.Garagen.Count; i++)
                await JSRuntime.InvokeVoidAsync("initFahrzeugSortable", dotnetRef, i);
        }
    }

    [JSInvokable]
    public async Task OnReorder(int oldIndex, int newIndex)
    {
        await GarageService.GarageVerschieben(oldIndex, newIndex);
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("initSortable", dotnetRef);
    }

    [JSInvokable]
    public async Task OnFahrzeugReorder(int garageIndex, int oldIndex, int newIndex)
    {
        var garage = GarageService.Garagen[garageIndex];
        await GarageService.FahrzeugVerschieben(garage, oldIndex, newIndex);
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("initFahrzeugSortable", dotnetRef, garageIndex);
    }

    private void BearbeitenOeffnen(Garage garage)
    {
        bearbeitenGarage = garage;
        editGarageName = garage.Name;
        neuesFahrzeug = "";
    }

    private void BearbeitenSchliessen() => bearbeitenGarage = null;

    private async Task BearbeitenSpeichern()
    {
        if (bearbeitenGarage != null)
        {
            await GarageService.GarageUmbenennen(bearbeitenGarage, editGarageName);
            await GarageService.Speichern();
        }
        bearbeitenGarage = null;
    }

    private async Task GarageLoeschenClick()
    {
        if (bearbeitenGarage != null)
        {
            await GarageService.GarageLoeschen(bearbeitenGarage);
            bearbeitenGarage = null;
        }
    }

    private async Task FahrzeugHinzufuegenClick()
    {
        if (bearbeitenGarage != null && !string.IsNullOrWhiteSpace(neuesFahrzeug))
        {
            await GarageService.FahrzeugHinzufuegen(bearbeitenGarage, neuesFahrzeug);
            neuesFahrzeug = "";
        }
    }

    private async Task FahrzeugLoeschenClick(Fahrzeug fahrzeug)
    {
        await GarageService.FahrzeugLoeschen(fahrzeug);
    }

    private async Task FotoHochladen(InputFileChangeEventArgs e)
    {
        if (bearbeitenGarage == null) return;
        var datei = e.File;
        var dateiName = $"{Guid.NewGuid()}{Path.GetExtension(datei.Name)}";
        var pfad = Path.Combine(GarageService.FotoPfad, dateiName);
        using var stream = datei.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var fs = File.Create(pfad);
        await stream.CopyToAsync(fs);
        await GarageService.FotoSetzen(bearbeitenGarage, dateiName);
    }

    private async Task FotoLoeschenClick()
    {
        if (bearbeitenGarage != null)
            await GarageService.FotoLoeschen(bearbeitenGarage);
    }

    private void NeueGarageOeffnen() { neueGarageOffen = true; neuerGarageName = ""; }
    private void NeueGarageSchliessen() => neueGarageOffen = false;

    private async Task NeueGarageSpeichern()
    {
        if (!string.IsNullOrWhiteSpace(neuerGarageName))
        {
            await GarageService.GarageHinzufuegen(neuerGarageName);
            neuerGarageName = "";
            neueGarageOffen = false;
        }
    }
}

